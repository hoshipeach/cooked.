  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cooked.local/schema/cooking-plan.schema.v1.json","title":"COOKED! Cooking Plan v1","type":"object","required":["schemaVersion","planId","revision","timezone","menu","service","dishes","ingredients","timeline"],
